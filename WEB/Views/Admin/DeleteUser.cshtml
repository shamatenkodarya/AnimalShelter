@using BLL.DTO
@model UserDTO
@{
    ViewData["Title"] = "Удалить пользователя";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Подтверждение удаления пользователя</h2>
    <hr />

    <div class="alert alert-danger">
        Вы уверены, что хотите удалить пользователя <strong>@Model.FullName (@Model.Email)</strong>?
        Это действие необратимо! Все данные, связанные с этим пользователем (например, история усыновлений, отзывы), могут быть также удалены или стать недоступными.
        <p class="fw-bold mt-2">Обратите внимание: Вы не можете удалить свою учетную запись или единственного администратора в системе.</p>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Полное имя</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Роли</dt>
        <dd class="col-sm-9">
            @if (Model.Roles != null && Model.Roles.Any())
            {
                @string.Join(", ", Model.Roles.OrderBy(r => r))
            }
            else
            {
                <span>Нет ролей</span>
            }
        </dd>
    </dl>

    <form asp-action="DeleteUser" asp-route-userId="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.Id" />
        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> Да, удалить пользователя</button>
            <a asp-action="Users" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>