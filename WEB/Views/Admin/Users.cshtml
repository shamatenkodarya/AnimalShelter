@using BLL.DTO
@model IEnumerable<UserDTO>
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">
    <h2><i class="bi bi-people-fill"></i> Управление пользователями</h2>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover table-responsive-md">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Имя</th>
                    <th>Роли</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FullName</td>
                        <td>
                            @if (user.Roles != null && user.Roles.Any())
                            {
                                @foreach (var role in user.Roles.OrderBy(r => r))
                                {
                                    <span class="badge rounded-pill
                                        @(role == "Admin" ? "bg-danger" :
                                          role == "Manager" ? "bg-success" :
                                          role == "Consultant" ? "bg-info text-dark" :
                                          role == "Controller" ? "bg-warning text-dark" :
                                          "bg-secondary")">@role</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">Нет ролей</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ManageRoles" asp-route-userId="@user.Id"
                               class="btn btn-sm btn-outline-primary me-1" title="Редактировать роли">
                                <i class="bi bi-person-gear"></i> Роли
                            </a>
                            <a asp-action="DeleteUser" asp-route-userId="@user.Id"
                               class="btn btn-sm btn-outline-danger" title="Удалить пользователя">
                                <i class="bi bi-trash3"></i> Удалить
                            </a>
                            @*                     *@
                            @*                           *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">В системе пока нет зарегистрированных пользователей (кроме, возможно, вас).</div>
    }
</div>