@*               *@
@model IEnumerable<BLL.DTO.ReviewDTO>
@*                                 *@

@if (Model != null && Model.Any())
{
    @foreach (var review in Model)
    {
        @*                                 *@
        <div class="col-md-4 mb-4">
            @*                        *@
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@review.UserName</h5>
                    @if (!string.IsNullOrEmpty(review.AnimalName))
                    {
                        <h6 class="card-subtitle mb-2 text-muted">О: <a asp-controller="Animal" asp-action="Details" asp-route-id="@review.AnimalId" class="link-secondary stretched-link">@review.AnimalName</a></h6>
                    }
                    <p class="card-text flex-grow-1">"@review.Content"</p>
                    <small class="text-muted align-self-end">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                </div>
            </div>
        </div>
    }
}
else
{
    @*                                 *@
    <div class="col-12">
        @*                     *@
    </div>
}