@model IEnumerable<BLL.DTO.AnimalDTO>
@using DAL.Entities 
@{
    ViewData["Title"] = "Список всех животных";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-list-ul"></i> Список всех животных (@Model.Count())</h2>
        <a asp-action="AddAnimal" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Добавить новое животное</a>
    </div>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover table-responsive-lg">
            <thead class="table-light">
                <tr>
                    <th scope="col">Фото</th>
                    <th scope="col">Имя</th>
                    <th scope="col">Тип</th>
                    <th scope="col">Возраст</th>
                    <th scope="col">Пол</th>
                    <th scope="col">Статус</th>
                    <th scope="col" class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var animal in Model.OrderBy(a => a.Name))
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(animal.PhotoBase64))
                            {
                                <img src="data:image/*;base64,@animal.PhotoBase64" class="rounded" style="height: 50px; width: 50px; object-fit: cover;" alt="@animal.Name">
                            }
                            else
                            {
                                <img src="~/images/placeholder.png" class="rounded" style="height: 50px; width: 50px; object-fit: cover;" alt="Нет фото">
                            }
                        </td>
                        <td>
                            <a asp-controller="Animal" asp-action="Details" asp-route-id="@animal.Id">@animal.Name</a>
                        </td>
                        <td>@animal.Type</td>
                        <td>@animal.Age лет</td>
                        <td>@animal.Gender</td>
                        <td>
                            @if (animal.IsAdopted)
                            {
                                <span class="badge bg-success"><i class="bi bi-house-heart-fill"></i> Нашел дом</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-search-heart"></i> Ищет дом</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Animal" asp-action="Details" asp-route-id="@animal.Id"
                               class="btn btn-sm btn-outline-info me-1" title="Подробнее">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="EditAnimal" asp-route-id="@animal.Id"
                               class="btn btn-sm btn-outline-warning me-1" title="Редактировать">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="DeleteAnimal" asp-route-id="@animal.Id"
                               class="btn btn-sm btn-outline-danger" title="Удалить">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">В приюте пока нет животных. Вы можете <a asp-action="AddAnimal">добавить первое</a>.</div>
    }
</div>