@model BLL.DTO.AnimalDTO
@{
    ViewData["Title"] = "Удалить животное";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Подтверждение удаления</h2>
    <hr />

    <div class="alert alert-danger">
        Вы уверены, что хотите удалить следующее животное? Это действие необратимо!
        <p class="fw-bold mt-2">Обратите внимание: Если с этим животным связаны записи об усыновлении, удаление может быть невозможно.</p>
    </div>

    <div class="card mb-3" style="max-width: 540px;">
        <div class="row g-0">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.PhotoBase64))
                {
                    <img src="data:image/*;base64,@Model.PhotoBase64" class="img-fluid rounded-start" alt="@Model.Name">
                }
                else
                {
                    <img src="~/images/placeholder.png" class="img-fluid rounded-start" alt="Фото отсутствует">
                }
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@Model.Name</h5>
                    <p class="card-text">
                        <strong>ID:</strong> @Model.Id <br>
                        <strong>Тип:</strong> @Model.Type <br>
                        <strong>Возраст:</strong> @Model.Age лет <br>
                        <strong>Пол:</strong> @Model.Gender <br>
                        <strong>Статус:</strong> @(Model.IsAdopted ? "Усыновлен" : "Ищет дом")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="DeleteAnimal" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3"></i> Да, удалить</button>
            <a asp-action="AnimalList" class="btn btn-secondary">Отмена</a>
            <a asp-action="EditAnimal" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Редактировать вместо удаления</a>
        </div>
    </form>
</div>

