@using DAL.Entities
@model AnimalViewModel
@{
    ViewData["Title"] = $"Редактировать: {Model.Name}";
}

<div class="container mt-4">
    <h2><i class="bi bi-pencil-square"></i> Редактирование: @Model.Name</h2>
    <hr />

    <form asp-action="EditAnimal" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />             
        <input type="hidden" asp-for="ExistingPhotoBase64" />                   
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-5">
                <div class="mb-3 text-center">
                    <label class="form-label fw-bold">Текущее фото:</label><br />
                    @if (!string.IsNullOrEmpty(Model.ExistingPhotoBase64))
                    {
                        <img src="data:image/*;base64,@Model.ExistingPhotoBase64" class="img-thumbnail mb-2" style="max-height: 300px; max-width: 100%;" alt="Текущее фото">
                    }
                    else
                    {
                        <img src="~/images/placeholder.png" class="img-thumbnail mb-2" style="max-height: 300px; max-width: 100%;" alt="Фото отсутствует">
                    }
                    <div class="mt-2">
                        <label asp-for="PhotoFile" class="form-label">Загрузить новое фото (заменит текущее)</label>
                        <input type="file" asp-for="PhotoFile" class="form-control form-control-sm" accept="image/*">
                        <span asp-validation-for="PhotoFile" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Статус:</label>
                    <input type="text" class="form-control" value="@(Model.IsAdopted ? "Усыновлен" : "Ищет дом")" readonly disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Дата поступления:</label>
                    <input type="text" class="form-control" value="@Model.AdmissionDate.ToString("dd.MM.yyyy")" readonly disabled />
                </div>
            </div>

            <div class="col-md-7">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<AnimalType>()" class="form-select"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" type="number" class="form-control">
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Weight" class="form-label"></label>
                    <input asp-for="Weight" type="number" step="any" class="form-control" placeholder="Например, 5.2 или 10">
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>

                <hr>
                <h4>Дополнительная информация</h4>
                <div class="mb-3">
                    <label asp-for="Breed" class="form-label"></label>
                    <input asp-for="Breed" class="form-control">
                    <span asp-validation-for="Breed" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control">
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="BehaviorDescription" class="form-label"></label>
                    <textarea asp-for="BehaviorDescription" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="BehaviorDescription" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="HealthNotes" class="form-label"></label>
                    <textarea asp-for="HealthNotes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="HealthNotes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr />
        <h4><i class="bi bi-shield-check"></i> Прививки</h4>
        @if (Model.Vaccinations != null && Model.Vaccinations.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var vacc in Model.Vaccinations.OrderByDescending(v => v.DateAdministered))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            @vacc.Name (@vacc.DateAdministered.ToString("dd.MM.yyyy"))
                        </span>
                        @*                  *@
                        @*          *@
                    </li> @*              *@
                }
            </ul>
        }
        else
        {
            <div class="alert alert-light">Прививок пока нет.</div>
        }

        <h5>Добавить новую прививку</h5>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-6">
                <label asp-for="NewVaccinationName" class="form-label"></label>
                <input asp-for="NewVaccinationName" class="form-control">
            </div>
            <div class="col-md-4">
                <label asp-for="NewVaccinationDate" class="form-label"></label>
                <input asp-for="NewVaccinationDate" type="date" class="form-control">
            </div>
            <div class="col-md-2">
                <span class="form-text text-muted">Будет добавлена при сохранении изменений.</span>
            </div>
        </div>


        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
            <a asp-action="AnimalList" class="btn btn-secondary me-md-2">Отмена</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Сохранить изменения</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
