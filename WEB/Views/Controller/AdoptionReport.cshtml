@using DAL.Entities
@using System.Text.Json 
@model WEB.Models.ControllerReportViewModel
@{
    ViewData["Title"] = "Отчет по усыновлениям";
    var reportGenerated = Model.ReportResult != null;

    string chartLabelsJson = "[]";
    string chartDataJson = "[]";
    if (reportGenerated && Model.ReportResult.AdoptionsByType != null && Model.ReportResult.AdoptionsByType.Any())
    {
        chartLabelsJson = JsonSerializer.Serialize(Model.ReportResult.AdoptionsByType.Keys);
        chartDataJson = JsonSerializer.Serialize(Model.ReportResult.AdoptionsByType.Values);
    }
}
@*                    *@
@*              *@

<div class="container mt-4">
    <h2><i class="bi bi-file-earmark-bar-graph"></i> Отчет по усыновлениям</h2>
    <hr />

    <form asp-action="AdoptionReport" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-end bg-light p-3 rounded mb-4 border">
            <div class="col-md-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AnimalTypeFilter" class="form-label"></label>
                <select asp-for="AnimalTypeFilter" asp-items="Html.GetEnumSelectList<AnimalType>()" class="form-select">
                    <option value="">-- Все типы --</option>
                </select>
                <span asp-validation-for="AnimalTypeFilter" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Сформировать</button>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    </form>

    @if (reportGenerated)
    {
        <hr>
        <h3 class="text-center mb-3">@ViewBag.ReportTitle</h3>
        <p class="text-center text-muted">Период: @Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</p>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header">График усыновлений по типам</div>
                    <div class="card-body">
                        @if (Model.ReportResult.AdoptionsByType != null && Model.ReportResult.AdoptionsByType.Any())
                        {
                            <canvas id="adoptionReportChart"></canvas>
                        }
                        else
                        {
                            <p class="text-center text-muted fst-italic">Нет данных для построения графика.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header">Данные по усыновлениям</div>
                    <div class="card-body">
                        @if (Model.ReportResult.AdoptionsByType != null && Model.ReportResult.AdoptionsByType.Any())
                        {
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Тип животного</th>
                                        <th class="text-end">Количество</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ReportResult.AdoptionsByType.OrderByDescending(kv => kv.Value))
                                    {
                                        <tr>
                                            <td>@item.Key</td>
                                            <td class="text-end">@item.Value</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light fw-bold">
                                        <td>ИТОГО:</td>
                                        <td class="text-end">@Model.ReportResult.TotalAdoptions</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                        else
                        {
                            <p class="text-center text-muted fst-italic">За выбранный период и тип животных усыновлений не зафиксировано.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ViewContext.HttpContext.Request.Method == "POST")                       
    {
        <div class="alert alert-warning">Не удалось сгенерировать отчет. Проверьте параметры или попробуйте позже.</div>
    }

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (reportGenerated && Model.ReportResult.AdoptionsByType != null && Model.ReportResult.AdoptionsByType.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const ctx = document.getElementById('adoptionReportChart')?.getContext('2d');
                if(ctx) {
                    // Используем переменные с JSON строками
                    const labels = @Html.Raw(chartLabelsJson);
                    const data = @Html.Raw(chartDataJson);

                    new Chart(ctx, {
                        type: 'pie', // Или 'bar' для сравнения
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Количество усыновлений',
                                data: data,
                                backgroundColor: [ // Можно добавить больше цветов или генерировать динамически
                                    '#0d6efd', '#ffc107', '#198754', '#dc3545', '#6f42c1', '#fd7e14', '#20c997', '#d63384',
                                    '#6c757d', '#adb5bd', '#0dcaf0', '#f8f9fa' // Добавьте больше цветов, если типов много
                                ].slice(0, labels.length), // Обрезаем массив цветов до нужного количества
                                borderColor: '#ffffff',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'right', // Позиция легенды
                                },
                                title: {
                                    display: false, // Заголовок уже есть
                                    // text: '@ViewBag.ReportTitle' // Можно добавить, если нужно
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}