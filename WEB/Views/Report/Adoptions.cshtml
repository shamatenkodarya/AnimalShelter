<div class="report-container">
    <h3>Отчет по усыновлениям с @Model.StartDate.ToShortDateString() по @Model.EndDate.ToShortDateString()</h3>

    <div class="chart-container">
        <canvas id="adoptionsChart"></canvas>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Тип животного</th>
                <th>Количество усыновлений</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.AdoptionsByType)
            {
                <tr>
                    <td>@item.Key</td>
                    <td>@item.Value</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('adoptionsChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.AdoptionsByType.Keys)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.AdoptionsByType.Values)),
                    backgroundColor: [
                        '#ff6384', '#36a2eb', '#ffce56', '#4bc0c0'
                    ]
                }]
            }
        });
    </script>
}